{% set project = load_lua(path="config/project.lua") -%}
{% set personal = load_lua(path="config/personal.lua") -%}
<!DOCTYPE html>
<html>
	<head>
		<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
		<title>{{ project.NAME }}</title>
		<link rel="shortcut icon" href="../static/favicon.ico"/>
		<meta name="Description" content="{{ project.DESCRIPTION_LONG | escape }}"/>
		<meta name="Keywords" content="{{ personal.FULLNAME }}, {{ personal.SLUG }}, {{ project.NAME }}, {{ project.KEYWORDS | join(sep=", ") }}"/>
	</head>
	<body>
		<h1>Welcome to the <i>{{ project.NAME }}</i> web site</h1>

		<p>current version is {{ version_str(path="config/version.lua") }}</p>

		<h2>Fastlog</h2>
		<p>
		TBD
		</p>
		<p>
			Copyright {{ personal.FULLNAME }} © {{ copyright_years() }}
			<a href="mailto:{{ personal.EMAIL }}">{{ personal.EMAIL }}</a>
		</p>
	</body>
</html>
